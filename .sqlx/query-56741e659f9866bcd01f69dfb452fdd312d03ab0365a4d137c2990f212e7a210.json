  "query": "\n        SELECT id, username, name, email, mobile, status\n        FROM sys_user\n        WHERE deleted_at IS NULL\n          AND ($1::varchar IS NULL OR username LIKE '%' || $1 || '%')\n          AND ($2::varchar IS NULL OR email = $2)\n          AND ($3::varchar IS NULL OR status = $3)\n        ORDER BY created_at DESC\n        LIMIT $4 OFFSET $5\n        ",
